<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.his.mapper.EmployeeMapper">

    <select id="selectByUsername" resultType="com.his.entity.Employee">
        SELECT * FROM employee WHERE username = #{username} AND delmark = 1
    </select>

    <select id="selectActive" resultType="com.his.entity.Employee">
        SELECT * FROM employee WHERE delmark = 1
    </select>
</mapper>
