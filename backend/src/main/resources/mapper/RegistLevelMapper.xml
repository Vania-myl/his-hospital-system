<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.his.mapper.RegistLevelMapper">

    <select id="selectActive" resultType="com.his.entity.RegistLevel">
        SELECT * FROM regist_level WHERE delmark = 1
    </select>

    <select id="selectById" resultType="com.his.entity.RegistLevel">
        SELECT * FROM regist_level WHERE id = #{id}
    </select>
</mapper>
